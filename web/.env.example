# ==============================================================================
# Stellar Wave Hub — Environment Configuration Example
# Copy this file to `.env.local` and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site & API URLs
# ------------------------------------------------------------------------------
# Public URL where the web application is hosted
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL for API requests (defaults to NEXT_PUBLIC_SITE_URL if omitted)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database & Storage (Supabase)
# ------------------------------------------------------------------------------
# URL of your Supabase project (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Public anon key for client-side queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Service role key for server-side privileged operations (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify user authentication tokens.
# Required in production (the server refuses to start without it); use a
# unique random secret with at least 32 characters.
JWT_SECRET=your-random-32-character-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 4. Stellar & Soroban Blockchain Configuration
# ------------------------------------------------------------------------------
# Stellar network mode ("testnet" or "public")
NEXT_PUBLIC_CONTRACT_NETWORK=testnet

# Soroban RPC endpoint URL
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Horizon API endpoint URL
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Deployed Soroban registry contract ID (starts with 'C')
NEXT_PUBLIC_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# USDC Stellar Asset Contract for the selected network; required for the
# admin treasury history chart. Use an archival Soroban RPC endpoint above to
# get the full 90-day history.
NEXT_PUBLIC_USDC_SAC=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Price of one week of homepage hero sponsorship, in XLM (defaults to 150)
NEXT_PUBLIC_PRICE_HERO_SPONSOR_XLM=150

# Stellar account (starts with 'G') that receives hero sponsorship payments;
# the booking API verifies incoming payments against this destination.
HERO_SPONSOR_WALLET=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ------------------------------------------------------------------------------
# 5. Background Cron & Automation
# ------------------------------------------------------------------------------
# Secret token to authorize scheduled cron requests (e.g. /api/cron/snapshots)
CRON_SECRET=your-cron-secret-token-placeholder
